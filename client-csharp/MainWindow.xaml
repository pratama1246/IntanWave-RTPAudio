<Window x:Class="IntanWave.Node.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IntanWave Node — Pro IP Audio Receiver" 
        Height="720" Width="520"
        MinHeight="680" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Pro Audio Palette -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="#0B0F19" />
        <SolidColorBrush x:Key="PanelBrush" Color="#111827" />
        <SolidColorBrush x:Key="PanelCardBrush" Color="#162032" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#1F2E45" />
        <SolidColorBrush x:Key="PanelHighlightBrush" Color="#2A3D5B" />
        
        <SolidColorBrush x:Key="CyanAccentBrush" Color="#00D2FF" />
        <SolidColorBrush x:Key="EmeraldOnlineBrush" Color="#10B981" />
        <SolidColorBrush x:Key="AmberWarningBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="CrimsonOnAirBrush" Color="#EF4444" />
        
        <SolidColorBrush x:Key="TextMainBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="TextDimBrush" Color="#64748B" />
        <SolidColorBrush x:Key="LedOffBrush" Color="#1A2536" />

        <!-- Glow Effects -->
        <DropShadowEffect x:Key="CyanGlow" Color="#00D2FF" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
        <DropShadowEffect x:Key="EmeraldGlow" Color="#10B981" BlurRadius="12" ShadowDepth="0" Opacity="0.7"/>
        <DropShadowEffect x:Key="RedGlow" Color="#EF4444" BlurRadius="14" ShadowDepth="0" Opacity="0.8"/>

        <!-- Professional Slider Style -->
        <Style x:Key="ProAudioSlider" TargetType="Slider">
            <Setter Property="Background" Value="#1A2536" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Pro Button Style -->
        <Style x:Key="ProBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A3D5B" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D2FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F172A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0: Header & Callout -->
            <RowDefinition Height="Auto" /> <!-- 1: Hero On-Air Banner -->
            <RowDefinition Height="Auto" /> <!-- 2: Segmented VU Meter -->
            <RowDefinition Height="Auto" /> <!-- 3: Master Gain & Controls -->
            <RowDefinition Height="Auto" /> <!-- 4: Channel Matrix -->
            <RowDefinition Height="*" />    <!-- 5: Telemetry HUD & Settings -->
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- 0. CONSOLE HEADER                                                 -->
        <!-- ================================================================= -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" 
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" 
                CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Branded Logo & Icon -->
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#162032" 
                        BorderBrush="{StaticResource CyanAccentBrush}" BorderThickness="1" Margin="0,0,12,0">
                    <Image Source="Assets/app_icon.png" Width="26" Height="26" Stretch="Uniform" />
                </Border>

                <!-- Titles -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="INTANWAVE" FontWeight="Black" FontSize="15"  Foreground="{StaticResource TextMainBrush}" />
                        <TextBlock Text="NODE" FontWeight="Light" FontSize="15"  Foreground="{StaticResource CyanAccentBrush}" Margin="6,0,0,0" />
                        <Border Background="#16293D" BorderBrush="#00D2FF" BorderThickness="0.8" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PRO AUDIO" FontSize="8" FontWeight="Bold" Foreground="#00D2FF" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Pelindo Multi Terminal IP Speaker Receiver Engine" FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- OS Auto-Detect Badge -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="OsBadge" Background="#162032" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="OsLedDot" Width="6" Height="6" Fill="{StaticResource CyanAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="OsBadgeText" Text="WINDOWS AUTO" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- 1. HERO ON-AIR / BROADCAST MONITOR                                -->
        <!-- ================================================================= -->
        <Border Grid.Row="1" x:Name="HeroCard" Background="{StaticResource PanelCardBrush}" 
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" 
                CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status Banner Bar -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status Pill (Standby vs On-Air) -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <Border x:Name="StatusBadge" Background="{StaticResource EmeraldOnlineBrush}" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusGlowDot" Width="7" Height="7" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusText" Text="STANDBY" FontWeight="Black" FontSize="11"  Foreground="White" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="SourceBadge" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="7,3" Visibility="Collapsed">
                            <TextBlock x:Name="SourceText" Text="RTP MULTICAST" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Active Mode / Category -->
                    <TextBlock Grid.Column="1" x:Name="ActiveCategoryText" Text="STANDBY MONITORING" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                </Grid>

                <!-- Dynamic Title / Stream Info -->
                <Border Grid.Row="1" Background="#0C1322" BorderBrush="#1C283C" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="▶" Foreground="{StaticResource CyanAccentBrush}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="BroadcastTitleText" Text="Standby mendengarkan paket siaran audio multicast..." 
                                   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" 
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- 2. HARDWARE-GRADE SEGMENTED LED VU METER                          -->
        <!-- ================================================================= -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" 
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" 
                CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
                <!-- Meter Header & dB Readout -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <TextBlock Text="SIGNAL LEVEL" FontSize="10" FontWeight="Black"  Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="(PEAK VU)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" x:Name="VuLevelDbText" Text="-INF dB" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}" VerticalAlignment="Center" />
                </Grid>

                <!-- Precision Segmented LED Bar Container (24 Segments) -->
                <Border Background="#090E17" BorderBrush="#1A2638" BorderThickness="1" CornerRadius="4" Padding="6,8">
                    <UniformGrid x:Name="VuMeterGrid" Rows="1" Columns="24" Height="14">
                        <!-- 24 Hardware LED Blocks Generated Dynamically in CodeBehind -->
                    </UniformGrid>
                </Border>

                <!-- dB Scale Tick Labels -->
                <Grid Margin="4,4,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="-48" FontFamily="Consolas" FontSize="8" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1" Text="-36" FontFamily="Consolas" FontSize="8" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="-24" FontFamily="Consolas" FontSize="8" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="-12" FontFamily="Consolas" FontSize="8" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="-6" FontFamily="Consolas" FontSize="8" Foreground="{StaticResource AmberWarningBrush}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="-3" FontFamily="Consolas" FontSize="8" Foreground="{StaticResource AmberWarningBrush}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="CLIP" FontFamily="Consolas" FontSize="8" FontWeight="Bold" Foreground="{StaticResource CrimsonOnAirBrush}" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================================================================= -->
        <!-- 3. MASTER GAIN & QUICK ACTIONS                                    -->
        <!-- ================================================================= -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" 
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" 
                CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Volume Slider Row -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="🔊" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="MASTER GAIN:" FontSize="10" FontWeight="Black"  Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Slider Grid.Column="1" x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100" 
                            ValueChanged="VolumeSlider_ValueChanged" Style="{StaticResource ProAudioSlider}" VerticalAlignment="Center" />

                    <Border Grid.Column="2" Background="#0C1322" BorderBrush="#1C283C" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="10,0,0,0">
                        <TextBlock x:Name="VolumePercentText" Text="100%" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="{StaticResource CyanAccentBrush}" Width="40" TextAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Tactile Control Buttons -->
                <UniformGrid Grid.Row="1" Columns="3">
                    <Button Content="🔔 TES CHIME" Click="TestChime_Click" Style="{StaticResource ProBtn}" 
                            BorderBrush="#0284C7" Background="#0F243A" Foreground="#38BDF8" Margin="0,0,4,0" />
                    <Button Content="⏹ STOP AUDIO" Click="StopAudio_Click" Style="{StaticResource ProBtn}" 
                            Background="#1E293B" Foreground="#94A3B8" Margin="4,0,4,0" />
                    <Button Content="📁 MEDIA CACHE" Click="OpenMediaFolder_Click" Style="{StaticResource ProBtn}" 
                            Background="#162032" Foreground="{StaticResource TextMutedBrush}" Margin="4,0,0,0" />
                </UniformGrid>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- 4. CHANNEL MATRIX (ROUTING STATUS)                                -->
        <!-- ================================================================= -->
        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" 
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" 
                CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="AUDIO CHANNEL MATRIX" FontSize="9" FontWeight="Black"  Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8" />
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Channel 1: Server PA -->
                    <Border Grid.Column="0" Background="#131D2D" BorderBrush="#1E2E44" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CH 1: SERVER PA" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMainBrush}" />
                                <TextBlock Text="239.255.0.1 : 5004" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource TextDimBrush}" />
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{StaticResource EmeraldOnlineBrush}" VerticalAlignment="Center" ToolTip="Multicast Standby" />
                        </Grid>
                    </Border>

                    <!-- Channel 2: Control Room IP Phone -->
                    <Border Grid.Column="1" Background="#131D2D" BorderBrush="#1E2E44" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CH 2: CONTROL ROOM" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMainBrush}" />
                                <TextBlock Text="239.255.0.2 : 5004" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource TextDimBrush}" />
                            </StackPanel>
                            <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{StaticResource AmberWarningBrush}" VerticalAlignment="Center" ToolTip="Priority Override Standby" />
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================================================================= -->
        <!-- 5. TELEMETRY HUD & DRAWER                                         -->
        <!-- ================================================================= -->
        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Diagnostics Grid -->
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Server Status -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="SERVER CONNECTION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" />
                            <TextBlock x:Name="ServerStatusText" Text="● Online (Server PA)" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource EmeraldOnlineBrush}" />
                        </StackPanel>

                        <!-- Assigned Zone -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="ZONE / GROUPS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" />
                            <TextBlock x:Name="ZoneText" Text="Kantor" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" />
                        </StackPanel>

                        <!-- Node Identity -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="NODE ID" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" />
                            <TextBlock x:Name="NodeIdText" Text="node_unknown" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>

                        <!-- Local IP -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="NODE IP ADDRESS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" />
                            <TextBlock x:Name="NodeIpText" Text="127.0.0.1" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Configuration Drawer -->
                <Expander Header="⚙ KONFIGURASI JARINGAN &amp; SERVER" 
                          Foreground="{StaticResource TextMutedBrush}" 
                          Background="{StaticResource PanelBrush}" 
                          BorderBrush="{StaticResource PanelBorderBrush}" 
                          Padding="10" IsExpanded="False" FontSize="10" FontWeight="Bold">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Server PA URL:" FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="ServerUrlBox" Background="#0C1322" Foreground="#F8FAFC" BorderBrush="#1E2E44" Padding="8,6" Margin="0,0,0,8" FontFamily="Consolas" FontSize="11" />

                        <TextBlock Text="Nama Perangkat (Soundcard):" FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="DeviceNameBox" Background="#0C1322" Foreground="#F8FAFC" BorderBrush="#1E2E44" Padding="8,6" Margin="0,0,0,8" FontSize="11" />

                        <TextBlock Text="Zona Speaker (Grup, pisahkan koma):" FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="ZoneBox" Background="#0C1322" Foreground="#F8FAFC" BorderBrush="#1E2E44" Padding="8,6" Margin="0,0,0,12" FontSize="11" />

                        <Button Content="💾 SIMPAN &amp; REKONEKSI" Click="SaveConfig_Click" Style="{StaticResource ProBtn}" 
                                Background="#059669" BorderBrush="#10B981" Foreground="White" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
