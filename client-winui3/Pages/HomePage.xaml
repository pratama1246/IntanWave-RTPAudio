<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IntanWaveNode.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:IntanWaveNode.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
        <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Stretch">

            <!-- 1. Broadcast Hero Alert (WinUI 3 InfoBar) -->
            <InfoBar x:Name="BroadcastInfoBar"
                     IsOpen="True"
                     IsClosable="False"
                     Severity="Success"
                     Title="STANDBY"
                     Message="Standby mendengarkan paket siaran audio multicast (239.255.0.1:5004)">
                <InfoBar.ActionButton>
                    <Button Content="Tes Bunyi Ampli" Click="TestChime_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- 2. Signal Level & Segmented VU Meter Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE995;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="SIGNAL LEVEL (PEAK VU)" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="VuDbText" Text="-INF dB" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Grid>

                    <!-- 24-Segment LED Meter Grid -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,8">
                        <Grid x:Name="VuSegmentsContainer" Height="14">
                            <!-- 24 hardware-styled segments populated dynamically -->
                        </Grid>
                    </Border>

                    <!-- dB Scale Reference -->
                    <Grid Margin="2,0,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="-48" FontFamily="Consolas" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1" Text="-36" FontFamily="Consolas" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="-24" FontFamily="Consolas" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="-12" FontFamily="Consolas" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="-6" FontFamily="Consolas" FontSize="9" Foreground="#F59E0B" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="-3" FontFamily="Consolas" FontSize="9" Foreground="#F59E0B" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="CLIP" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Master Gain & Quick Actions Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,14,0">
                            <FontIcon Glyph="&#xE767;" FontSize="16" />
                            <TextBlock Text="Master Output Gain:" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                        <Slider Grid.Column="1" x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100" ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="10,4" Margin="12,0,0,0">
                            <TextBlock x:Name="VolumePctText" Text="100%" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Width="44" TextAlignment="Center" />
                        </Border>
                    </Grid>

                    <CommandBar DefaultLabelPosition="Right" Background="Transparent" IsOpen="False">
                        <AppBarButton Icon="Play" Label="Tes Chime" Click="TestChime_Click" />
                        <AppBarButton Icon="Stop" Label="Stop Audio" Click="StopAudio_Click" />
                        <AppBarSeparator />
                        <AppBarButton Icon="Folder" Label="Folder Media" Click="OpenMediaFolder_Click" />
                    </CommandBar>
                </StackPanel>
            </Border>

            <!-- 4. Channel Matrix Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <StackPanel Spacing="10">
                    <TextBlock Text="AUDIO CHANNEL ROUTING MATRIX" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CH 1: Server PA -->
                        <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CH 1: SERVER PA PELINDO" FontWeight="Bold" FontSize="11" />
                                    <TextBlock Text="239.255.0.1 : 5004 (RTP)" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Ellipse Grid.Column="1" Width="10" Height="10" Fill="#10B981" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- CH 2: Control Room IP Phone -->
                        <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CH 2: CONTROL ROOM" FontWeight="Bold" FontSize="11" />
                                    <TextBlock Text="239.255.0.2 : 5004 (IP Phone)" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Ellipse Grid.Column="1" Width="10" Height="10" Fill="#F59E0B" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. Node Diagnostics Grid -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid RowSpacing="12" ColumnSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="SERVER CONNECTION" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ServerStatusText" Text="● Online (Server PA Pelindo)" FontWeight="Bold" FontSize="12" Foreground="#10B981" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock Text="ZONA / GRUP AUDIO" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ZoneText" Text="Kantor Operasional" FontWeight="Bold" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="NODE ID" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="NodeIdText" Text="node_DESKTOP_XYZ" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Text="LOCAL IP ADDRESS" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="NodeIpText" Text="127.0.0.1" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
