<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IntanWaveNode.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:IntanWaveNode.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
        <StackPanel Spacing="16" MaxWidth="760">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Width="48" Height="48" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="IntanWave Node" FontWeight="Bold" FontSize="18" />
                    <TextBlock Text="Universal IP Audio Receiver — Pelindo" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="TENTANG APLIKASI" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Aplikasi klien penerima siaran audio multicast (RTP) untuk amplifier sound system fisik terminal Pelindo Multi Terminal Tanjung Intan." TextWrapping="Wrap" />
                    <TextBlock Text="• Arsitektur: Windows App SDK / WinUI 3 (Fluent Design System, Mica Backdrop)" FontSize="12" />
                    <TextBlock Text="• Audio Pipeline: NAudio WASAPI Shared Stream Engine (Pure In-Memory G.711 / MP3)" FontSize="12" />
                    <TextBlock Text="• Jaringan: UDP Multicast (239.255.0.1:5004) &amp; WebSocket RFC 6455" FontSize="12" />
                    <TextBlock Text="• Versi: 1.0.0 (WinUI 3)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
